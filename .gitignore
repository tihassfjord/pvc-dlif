# --- generated output ---------------------------------------------------
# Everything the pipeline produces goes to the `work` directory configured
# in configs/*.yaml. Nothing generated belongs in version control.
#
# NOTE the leading slashes. A pattern without one matches a directory of that
# name at ANY depth: a bare `data/` silently excluded `src/pvc_dlif/data/` -
# grid.py, preprocess.py, dicom_io.py, pkl_io.py - so the published repository
# could not import its own package. Anchor anything meant as a top-level
# directory.
/thesis_work/
/work/
*.nii
*.nii.gz
*.pkl
*.parquet
*.pt
*.pth

# --- data ---------------------------------------------------------------
# The mouse dataset and the pretrained DLIF weights are not distributed
# with this repository. See docs/data.md.
/data/
/dicom/

# --- python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# --- editors / OS -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- local configuration ------------------------------------------------
# example.yaml is the template that ships; a filled-in config holds real
# paths to someone's dataset and does not belong in version control.
configs/thesis.yaml
configs/synthetic.yaml
HANDOVER_PROMPT.md

# --- stray artefacts ------------------------------------------------------
# A Windows path used as a relative path creates a literal `E:/` directory
# here; it holds nothing but a copy of a log the pipeline already wrote to
# the work directory.
/E:/
falconz-*.log
*.log
